# ====================================================
# PostgreSQL Connection Settings:
#   - POSTGRESQL_HOST: Host address where PostgreSQL server is reachable.
#                      Use "127.0.0.1" or "localhost" for local Docker host access.
# ====================================================
POSTGRESQL_HOST=localhost


# ====================================================
# Port Configuration:
#   - POSTGRESQL_INTERNAL_PORT: Internal port used within Docker network 
#                               for container-to-container communication
#   - POSTGRESQL_EXTERNAL_PORT: External port exposed to host machine for 
#                               direct PostgreSQL access from outside Docker
# ====================================================
POSTGRESQL_INTERNAL_PORT=5432
POSTGRESQL_EXTERNAL_PORT=5432


# ====================================================
# Docker Container Names:
#   - POSTGRESQL_SERVER_CONTAINER: PostgreSQL server container name for 
#                                  actual database instance
#   - POSTGRESQL_CLIENT_CONTAINER: PostgreSQL client container name for 
#                                  database administration, testing, and CLI access
# ====================================================
POSTGRESQL_SERVER_CONTAINER=postgres-server
POSTGRESQL_CLIENT_CONTAINER=postgres-client


# ====================================================
# PostgreSQL Superuser Configuration
# ====================================================
POSTGRESQL_SUPERUSER_NAME=postgres
POSTGRESQL_SUPERUSER_PASSWORD=password
POSTGRESQL_SYSTEM_DB_NAME=postgres


# ====================================================
# PostgreSQL Application Credentials
# (non-superuser account for application connectivity)
# ====================================================
POSTGRESQL_USERNAME=not_superuser
POSTGRESQL_PASSWORD=password
POSTGRESQL_DB_NAME=not_superuser_db


# ====================================================
# !!!!!!!!!!!!!!!!!!!Security Note!!!!!!!!!!!!!!!!!!!!
# ====================================================
# The superuser account (typically "postgres") has full server access,
# including the ability to create/drop databases and manage roles.
# It should be used exclusively for administrative tasks.
#
# The POSTGRESQL_USERNAME should be used for application connections
# to follow the principle of least privilege.
# ====================================================
# !!!!!!!!!!!!!!!!!!!Security Note!!!!!!!!!!!!!!!!!!!!
# ====================================================


# ====================================================
# PostgreSQL Persistent Data Storage Path:
#   - Local filesystem path where PostgreSQL data files, WAL logs,
#     and configuration will be persisted across container restarts
#     and recreations.
# ====================================================
POSTGRESQL_DATA_PATH=/path/to/postgresql-data


# ====================================================
# SQL Logging (Echo Mode):
#   - If True, all executed SQL statements are printed to stdout.
#   - Useful for debugging; should be disabled in production.
# ====================================================
POSTGRESQL_ECHO=False


# ====================================================
# Automatic Transaction Commits:
#   - If True, each database operation is automatically committed.
#   - Not recommended for production; explicit commits provide better control
#     over transaction boundaries and error handling.
# ====================================================
POSTGRESQL_AUTOCOMMIT=False


# ====================================================
# Automatic Session Flushing:
#   - If True, pending ORM changes are automatically synchronized to the database
#     before queries are executed.
#   - Disabling (False) gives explicit control via session.flush(),
#     improving predictability and reducing unintended side effects.
# ====================================================
POSTGRESQL_AUTOFLUSH=False